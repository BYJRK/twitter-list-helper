{
  "manifest_version": 3,
  "name": "X 列表助手",
  "description": "在用户主页查看自己的列表归属，通过下拉菜单一键添加或移除成员。",
  "version": "0.2.4",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "X 列表助手设置" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    { "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
